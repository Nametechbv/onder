<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_custom_label" model="ir.ui.view">
        <field name="name">product.custom.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Product Information" name="custom_label_page">
                    <group>
                        <field name="x_ingredient"/>
                        <field name="x_nutrition"/>
                        <field name="x_shelf"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_inherit_label" model="ir.ui.view">
        <field name="name">product.template.form.inherit.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <div class="oe_left">
                        <button name="%(action_report_product_label_custom)d"
                                string="Print Label"
                                type="action"
                                class="btn-primary"
                                style="margin: 4px;"/>
                    </div>
                </header>
            </xpath>
        </field>
</record>

</odoo>